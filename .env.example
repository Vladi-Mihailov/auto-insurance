# Copy this file to .env and fill in real values. Never commit .env.

# Cookie security flag — false for local http development, true once served over HTTPS.
COOKIE_SECURE=false

# Reserved for future use (signed links/CSRF) — not required by the current MVP slice.
APP_SECRET_KEY=

# Payment requisites shown on the payment screen. Placeholders below — replace with real values.
PAYMENT_BANK_NAME=T-Bank
PAYMENT_CARD_NUMBER=0000 0000 0000 0000
PAYMENT_CARD_HOLDER=IVAN IVANOV
# Optional: URL/path to a QR code image for the payment screen.
PAYMENT_QR_IMAGE_URL=
# Optional: direct link to pay via SBP/transfer (opens in a new tab from a
# "Перейти к оплате" button) -- an alternative to scanning the QR from the
# same device. Independent of PAYMENT_QR_IMAGE_URL: set either, both, or
# neither. Does not confirm payment by itself -- the customer still has to
# come back and click "Я оплатил".
PAYMENT_TRANSFER_URL=

# Optional: override the default SQLite file location (relative to project root).
# INSURANCE_DB_FILE=data/insurance.db

# Support contact links shown in the site header. Omit any you don't have yet —
# the corresponding link is simply not rendered.
CONTACT_MAX_URL=https://max.ru/yourhandle
CONTACT_TELEGRAM_URL=https://t.me/yourhandle
CONTACT_VK_URL=https://vk.com/yourhandle

# Document OCR ("Загрузить документы" on the vehicle-data step). Without this
# key, recognition is reported to users as temporarily unavailable — the app
# still starts fine and the manual-entry path is unaffected either way.
# Never put a real key in config.yaml — this is the ONLY place it belongs.
OPENAI_API_KEY=
# Optional: override the vision model used for document extraction.
# OCR_VISION_MODEL=gpt-5-mini

# Admin access (/admin/orders — manual payment confirmation review). Without
# BOTH of these set, admin routes fail closed (401 on every request) rather
# than becoming publicly accessible. Never put real credentials in
# config.yaml — this is the ONLY place they belong.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Operator Telegram notification: sent automatically once, right after an
# admin confirms payment (PAYMENT_REVIEW -> PAID) at /admin/orders. Uses
# Telethon (an authorized Telegram USER account) -- NOT the Bot API, no bot
# is created. TELEGRAM_API_ID/TELEGRAM_API_HASH/TELEGRAM_PHONE are the SAME
# values already used by the separate ai-lead-radar project (same Telegram
# account, already a member of the target chat) -- see
# app.notifications.telegram module docstring. TELEGRAM_OPERATOR_CHAT_ID is
# the numeric id (or @username) of that chat. Without ALL of these set, the
# notification is simply skipped (logged, never blocks or reverts the
# payment confirmation).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_OPERATOR_CHAT_ID=
# Optional: override the default session file location (relative to project
# root, ".session" is appended automatically). This MUST be a session
# belonging only to auto-insurance -- never point it at any ai-lead-radar
# session file. Run `python -m app.notifications.authorize_telegram_operator`
# once (after the four variables above are set) to create/authorize it.
# TELEGRAM_OPERATOR_SESSION_PATH=data/sessions/auto_insurance_operator
